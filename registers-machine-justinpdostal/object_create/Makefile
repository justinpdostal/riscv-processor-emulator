# C source files: must have a `main`, should *not* include anything
# (no dependencies)
# Assembly source files: must have a _start function, no dependencies
SFILES = $(wildcard ../tests/assembly/*.S)
# Binary output files, not to be shared.
BFILES = $(patsubst %.S,%.bin,$(SFILES))
# Assembly output files which can be shared.
AFILES = $(patsubst %.bin,%.asm,$(BFILES))
# The final gwu architecture object format, generated by the
# `obj_create.py` program. Shared with students, and the basis for the
# inputs for many levels.
AOBJS =  $(patsubst %.bin,%.archobj,$(BFILES))
# Raw, more readable assembly files that should be shared only when we
# want students to see both the source and assembly to understand how
# they map.
RFILES = $(patsubst %.bin,%.rawasm,$(BFILES))
# the solutions created with the provided soln
SOLNS =  $(patsubst %.bin,%.soln,$(BFILES))
SOLN  =  ../hw2/r5emu

CC = riscv64-unknown-elf-gcc
CFLAGS = -march=rv64i -mabi=lp64 -mcmodel=medlow -fno-pic -fno-PIC -fno-pie -fno-plt -ffreestanding -nostdlib -nostartfiles -nodefaultlibs -static -fno-jump-tables -Wl,--gc-sections -Wl,-T,riscv64-virt.ld
OBJDUMP = riscv64-unknown-elf-objdump
# print out the x* registers, rather than the ABI version, and
# get rid of the instruction aliases, instead use the raw instructions
OFLAGS = -Mnumeric --disassembler-options=no-aliases

all: solution $(AOBJS) $(AFILES) $(RFILES) $(BFILES) $(SOLNS)

solution:
	make --no-print-directory -C ../hw2

# gcc compiles .S file too!
%.bin: %.S
	$(CC) $(CFLAGS) -g $^ -o $@

%.bin: %.c _crt0.s
	$(CC) $(CFLAGS) -g $^ -o $@

%.soln: %.archobj
	$(SOLN) < $< > $@

%.archobj: %.bin
	python3 obj_create.py $^ > $@

%.asm: %.bin
# tail: ignore the first 6 lines;
# sed: strip out the labels "<blah>"; and
# awk: convert into the 2 column format we want.
	$(OBJDUMP) $(OFLAGS) -d $^ | tail -n +6 | sed "s/<.*>//g" | awk -F' ' '{ if (NF == 3) { print $$1 "\t" $$3; } else if (NF == 4 || NF == 5) { print $$1 "\t" $$3 " " $$4;} }' > $@

%.rawasm: %.bin
	$(OBJDUMP) --disassembler-options=no-aliases -Srhp $^ | tail -n +7 > $@

clean:
	rm -rf $(BFILES) $(RFILES) $(AFILES) $(AOBJS)
	rm -rf $(SOLNS)
	make -C ../hw2 clean
